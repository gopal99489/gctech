pipeline {
    agent any

    environment {
        SONARQUBE_SERVER = 'sonarqube'  // Name from Jenkins config
        SONARQUBE_PROJECT_KEY = 'sonar-jenkins-integration'
        SONARQUBE_PROJECT_NAME = 'sonar-jenkins-integration'
        CNES_CLI_URL = 'https://github.com/cnescatlab/sonar-cnes-report/releases/download/4.2.0/sonar-cnes-report-4.2.0.jar'
        REPORT_FILE = 'sonarqube-report.pdf'
        EMAIL_RECIPIENT = 'gopalarao.jonnakuti@spoors.in'
        SONARQUBE_URL = 'http://34.93.120.216:9000'
        JENKINS_WEBHOOK_URL = 'http://34.93.120.216:8080/sonarqube-webhook/' // Jenkins webhook URL
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/gopal99489/gctech.git'
            }
        }

        stage('Ensure SonarQube Webhook') {
            steps {
                withCredentials([string(credentialsId: 'sonar-jenkins-gc', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        set -e
                        existing=$(curl -s -u "$SONAR_TOKEN:" "$SONARQUBE_URL/api/webhooks/list" | grep -o '"url":"'"$JENKINS_WEBHOOK_URL"'"' || true)
                        if [ -z "$existing" ]; then
                          curl -s -u "$SONAR_TOKEN:" \
                            -X POST "$SONARQUBE_URL/api/webhooks/create" \
                            -d "name=Jenkins&url=$JENKINS_WEBHOOK_URL"
                        else
                          echo "Webhook already exists."
                        fi
                    '''
                }
            }
        }

        stage('SonarQube Scan') {
            steps {
                withCredentials([string(credentialsId: 'sonar-jenkins-gc', variable: 'SONAR_TOKEN')]) {
                    withSonarQubeEnv(SONARQUBE_SERVER) {
                        sh '''
                            mvn clean verify sonar:sonar \
                              -Dsonar.projectKey=$SONARQUBE_PROJECT_KEY \
                              -Dsonar.projectName=$SONARQUBE_PROJECT_NAME \
                              -Dsonar.login=$SONAR_TOKEN
                        '''
                    }
                }
            }
        }

        stage('Wait for Quality Gate') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Generate SonarQube PDF Report') {
            steps {
                withCredentials([string(credentialsId: 'sonar-jenkins-gc', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        curl -L -o cnes-cli.jar "$CNES_CLI_URL"
                        java -jar cnes-cli.jar \
                          -s "$SONARQUBE_URL" \
                          -t "$SONAR_TOKEN" \
                          -p "$SONARQUBE_PROJECT_KEY" \
                          -f "$REPORT_FILE"
                    '''
                }
            }
        }

        stage('Send Report via Email') {
            steps {
                emailext (
                    subject: "SonarQube Vulnerability Report for ${env.SONARQUBE_PROJECT_NAME}",
                    body: "Attached is the SonarQube vulnerability report for your project.",
                    to: "${EMAIL_RECIPIENT}",
                    attachmentsPattern: "${REPORT_FILE}"
                )
            }
        }
    }
}
