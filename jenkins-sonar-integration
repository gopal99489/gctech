pipeline {
  agent any

  tools {
    jdk 'jdk21'     // Must match the name configured in Jenkins Tools
    maven 'Maven'  // Must match the name configured in Jenkins Tools
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'Dev',
            credentialsId: 'github-gopal', // remove this line if repo is public
            url: 'https://github.com/gopal99489/gctech.git'
      }
    }

    stage('Build & Test') {
      steps {
        sh 'mvn -B clean verify'
      }
      post {
        always {
          junit 'target/surefire-reports/*.xml' // show test results in Jenkins
        }
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh """
            mvn -B sonar:sonar \
              -Dsonar.projectKey=effort-web \
              -Dsonar.host.url=$SONAR_HOST_URL \
              -Dsonar.login=$SONAR_AUTH_TOKEN
          """
        }
      }
    }

    stage('Quality Gate') {
      steps {
        // Requires SonarQube webhook: http://192.168.77.220:8080/sonarqube-webhook/
        timeout(time: 3, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }
  }

  post {
    success { echo 'Build + SonarQube analysis + Quality Gate: SUCCESS' }
    failure { echo 'Pipeline failed (build/tests/analysis or Quality Gate).' }
  }
}
