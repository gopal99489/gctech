pipeline {
  agent any

  tools {
    jdk 'jdk21'     // Must match the name configured in Jenkins Tools
    maven 'Maven'   // Must match the name configured in Jenkins Tools
  }

  stages {
    stage('Checkout') {
      steps {
        git branch: 'dev',
            credentialsId: 'github-gopal', // remove this line if repo is public
            url: 'https://github.com/gopal99489/gctech.git'
      }
    }

    stage('Build (No Tests)') {
      steps {
        sh 'mvn -B clean install -DskipTests'
      }
      post {
        always {
          echo "✅ Build completed (tests skipped)."
        }
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh """
            mvn -B sonar:sonar \
              -DskipTests \
              -Dsonar.projectKey=effort-web \
              -Dsonar.host.url=$SONAR_HOST_URL \
              -Dsonar.login=$SONAR_AUTH_TOKEN
          """
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 3, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }
  }

  post {
    success { echo '✅ Build + SonarQube analysis + Quality Gate: SUCCESS' }
    failure { echo '❌ Pipeline failed (build/analysis or Quality Gate).' }
  }
}
